---
import Layout from '../layouts/Layout.astro';import guide from '../data/guide.json';
const b=import.meta.env.BASE_URL.replace(/\/$/,'');const parts=guide.parts.filter(p=>p.id!=='liminaire');
const descriptions=['Comprendre les principes du RGPD et les enjeux de confidentialité documentaire.','Identifier les acteurs, les bases légales et la gouvernance des traitements.','Consulter les vingt fiches de traitements propres aux activités documentaires.','Définir les durées, organiser les archives et maîtriser la purge des données.','Protéger les systèmes, les accès et gérer les violations de données.','Structurer le diagnostic, le plan d’action et les contrôles périodiques.','Retrouver les modèles, les procédures et le glossaire sectoriel.'];
---
<Layout><section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="little-rule"></span> LE RÉFÉRENTIEL DOCUMENTAIRE DE LA FULBI</p><h1>La protection des données,<br/><em>au cœur de nos métiers.</em></h1><p class="lead">Le guide sectoriel RGPD des bibliothèques et centres de documentation. Un manuscrit intégral à consulter, à interroger et à enrichir ensemble.</p><div class="actions"><a class="button" href={`${b}/guide/`}>Commencer la lecture <span>→</span></a><a class="text-link" href={`${b}/concertation/`}>Contribuer à la relecture ↗</a></div><p class="version-line">VERSION V3 <span>·</span> Mise à jour le 16 novembre 2026 <span>·</span> Projet en concertation</p></div><div class="hero-art" aria-hidden="true"><div class="art-grid"></div><span class="art-label">LE GUIDE SECTORIEL</span><div class="book book-back"></div><div class="book book-front"><div class="book-top">FULBI <span>V3</span></div><span class="book-rule"></span><div class="book-title">GUIDE<br/>SECTORIEL<br/><strong>RGPD</strong></div><div class="book-bottom">BIBLIOTHÈQUES<br/>& CENTRES DE DOCUMENTATION</div><span class="book-mark">↗</span></div><span class="art-caption">Un cadre commun.<br/>Des pratiques adaptées.</span></div></section>
<section class="search-band" aria-labelledby="search-heading"><div><h2 id="search-heading">Un passage à retrouver ?</h2><p>Explorez l’intégralité du manuscrit.</p></div><form action={`${b}/recherche/`} role="search"><label class="sr-only" for="home-search">Rechercher dans le guide</label><input id="home-search" name="q" type="search" placeholder="Conservation, consentement, compte lecteur…"/><button type="submit" aria-label="Lancer la recherche">Rechercher →</button></form></section>
<section class="contents-section"><div class="section-heading"><div><p class="eyebrow">UN PARCOURS EN SEPT PARTIES</p><h2>Le guide, dans son intégralité</h2></div><a class="text-link" href={`${b}/guide/`}>Voir le sommaire détaillé →</a></div><div class="part-grid">{parts.map((p,i)=><a class:list={['part-card',i===6?'last-card':'']} href={`${b}/parties/${p.id.toLowerCase()}/`}><div class="card-top"><span class="part-number">{p.id}</span><span class="eyebrow">PARTIE {p.id}</span>{p.provisional&&<span class="badge">Provisoire</span>}</div><h3>{p.title.split('—')[1]?.trim()}</h3><p>{descriptions[i]}</p><span class="card-footer">{p.sections.length} sections <span>Lire la partie →</span></span></a>)}</div></section>
<section class="quick-grid"><a href={`${b}/fiches/`}><span class="large-number">20</span><div><h2>Fiches métier</h2><p>Des traitements ancrés dans vos pratiques.</p></div><span>→</span></a><a href={`${b}/outils/`}><span class="large-number">18</span><div><h2>Outils opérationnels</h2><p>Modèles, procédures et glossaire.</p></div><span>→</span></a></section>
<section class="participate"><div><p class="eyebrow">CONSTRUIRE UN CADRE PARTAGÉ</p><h2>Votre expérience nourrit le guide.</h2><p>Une précision juridique, une contradiction, une proposition ?<br/>Participez à une relecture ouverte et traçable sur GitHub.</p><a class="button" href={`${b}/concertation/`}>Découvrir la concertation →</a></div><div class="source-box"><span class="eyebrow">LE DOCUMENT DE RÉFÉRENCE</span><h3>Le manuscrit source</h3><p>Retrouvez la version Word intégrale à l’origine de cette plateforme.</p><a class="text-link" href={`${b}/documents/${guide.source}`} download>Télécharger le Word · 209 Ko ↓</a><a href={`${b}/documents/concordance.json`}>Consulter le rapport de concordance ↗</a></div></section></Layout>
