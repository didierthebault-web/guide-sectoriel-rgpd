---
import Layout from '../layouts/Layout.astro';import Section from './Section.astro';import guide from '../data/guide.json';
const {part,section}=Astro.props;const b=import.meta.env.BASE_URL.replace(/\/$/,'');const all=guide.sections.filter(s=>s.part===part.id);const items=section?[section]:all;const index=section?guide.sections.findIndex(s=>s.id===section.id):-1;const previous=guide.sections[index-1];const next=guide.sections[index+1];const parent=section?guide.sections.find(s=>s.id===section.parent):null;const children=section?guide.sections.filter(s=>s.parent===section.id):[];
---
<Layout title={section?.title||part.title} wide><div class="progress-track" aria-hidden="true"><div class="progress-bar"></div></div><div class="breadcrumb"><a href={`${b}/`}>Accueil</a> / <a href={`${b}/guide/`}>Guide</a> / <a href={`${b}/parties/${part.id.toLowerCase()}/`}>{part.title}</a>{section&&<> / {section.id}</>}</div><div class="reading-layout"><aside class="side-nav"><details open><summary>Sommaire · {part.id==='liminaire'?'Préambule':`Partie ${part.id}`}</summary><ul>{all.map(s=><li class={`level-${s.level}`}><a href={`${b}/sections/${s.id}/#${s.id}`} aria-current={section?.id===s.id?'page':undefined}>{s.title}</a></li>)}</ul></details><p><a href={`${b}/guide/`}>← Toutes les parties</a></p></aside><article class="reading-main" data-pagefind-body={section?'':undefined} data-pagefind-ignore={!section?'all':undefined}><p class="eyebrow" data-pagefind-filter={`Partie:${part.id}`}>GUIDE SECTORIEL RGPD · {part.id==='liminaire'?'PRÉAMBULE':`PARTIE ${part.id}`} · V3</p>{!section&&<h1>{part.title}</h1>}{part.provisional&&<p class="context-note provisional" data-pagefind-ignore><strong>Partie VI provisoire.</strong> Son contenu reste soumis à la concertation et au réexamen éditorial.</p>}{parent&&<p class="context-note" data-pagefind-ignore>Dans : <a href={`${b}/sections/${parent.id}/`}>{parent.title}</a> · <a href={`${b}/parties/${part.id.toLowerCase()}/#${section.id}`}>Lire dans le contexte intégral</a></p>}<div class="reading-toolbar" data-pagefind-ignore><button data-font="-1" aria-label="Réduire la taille du texte">A−</button><button data-font="1" aria-label="Augmenter la taille du texte">A+</button><button data-print>Imprimer</button><a href={`${b}/recherche/`}>Rechercher dans le guide</a></div>{items.map(s=><Section section={s} standalone={!!section}/>)}{children.length>0&&<div class="child-links" data-pagefind-ignore><strong>Sous-sections</strong><ul>{children.map(s=><li><a href={`${b}/sections/${s.id}/`}>{s.title}</a></li>)}</ul></div>}{section&&<nav class="section-nav" aria-label="Sections précédente et suivante" data-pagefind-ignore>{previous?<a href={`${b}/sections/${previous.id}/`}>← {previous.title}</a>:<span/>}{next&&<a href={`${b}/sections/${next.id}/`}>{next.title} →</a>}</nav>}<p class="context-note" data-pagefind-ignore>Parties associées : {guide.parts.filter(p=>p.id!==part.id&&p.id!=='liminaire').map(p=><> <a href={`${b}/parties/${p.id.toLowerCase()}/`}>{p.title}</a> · </>)}</p></article><aside class="local-nav"><details open><summary>Sur cette page</summary><ul>{items.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}</ul></details><p class="eyebrow">VERSION V3</p><p>Texte en concertation<br/>Non approuvé par la CNIL</p><a href={`${b}/validations/`}>Suivi des validations →</a></aside></div></Layout>
